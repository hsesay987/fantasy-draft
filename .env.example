# Web (Vercel). Copy to .env.local for local dev.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Product analytics (PostHog project API key, starts with phc_). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# Error monitoring (Sentry). Leave the DSN empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
# Source-map upload at build time (Vercel build env only; optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_CHARACTER_IMAGES=on   # "off" disables third-party character pictures
