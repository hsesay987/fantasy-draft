# API. Copy to backend/.env (secrets) and backend/.env.local (local overrides).
PORT=4001
HOST=127.0.0.1                      # 0.0.0.0 in containers
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:pass@localhost:5432/toppic_dev
JWT_SECRET=change-me

# AI judge (leave empty for the numbers-only fallback)
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-sonnet-5-5

# Monitoring (leave empty to disable)
SENTRY_DSN=
APP_ENV=development
SENTRY_TRACES_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
