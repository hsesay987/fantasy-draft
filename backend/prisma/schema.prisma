// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum CartoonChannel {
  Disney
  DisneyXD
  Nickelodeon
  CartoonNetwork
  AdultSwim
  Netflix
  Other
}

enum CartoonCategory {
  Comedy
  Action
  Superhero
  Educational
  AnimeStyle
  SliceOfLife
}

enum CartoonAgeRating {
  baby
  kids
  adult
}

enum CartoonGender {
  male
  female
  other
  unknown
}

enum CartoonDraftEntity {
  SHOW
  CHARACTER
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String?
  name             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  googleId         String?  @unique
  stripeCustomerId String?  @unique
  emailVerified    Boolean  @default(false)
  isAdmin          Boolean  @default(false)

  // 🔑 monetization
  subscriptionTier String? // null | "founder" | "monthly" | "yearly"
  subscriptionEnds DateTime?
  isFounder        Boolean   @default(false)

  // relationships
  drafts              Draft[]
  rooms               Room[]               @relation("RoomHost")
  roomMembers         RoomParticipant[]
  gameResults         GameResult[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  communityAds        CommunityAd[]        @relation("UserAds")
  revenueEvents       RevenueEvent[]
  draftStyles         DraftStyle[]
  topPicCardReports   TopPicCardReport[]
  customGames         CustomGame[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model GameResult {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  score     Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@index([userId])
}

model Game {
  id          String       @id @default(cuid())
  type        String // "DRAFT" | "IMPOSTER" | "QUIZ" | "AUX" | "LINEUP"
  category    String // "SPORTS" | "FOOD" | "ANIME" | "TV" | "MUSIC"
  subtype     String? // "NBA" | "NFL" | "ANIME" | "FOOD"
  title       String?
  createdAt   DateTime     @default(now())
  drafts      Draft[]
  gameResults GameResult[]
}

model Room {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String?
  league   String  @default("NBA")
  isPublic Boolean @default(false)
  status   String  @default("lobby") // "lobby" | "in_progress" | "completed"
  settings Json?

  hostId String
  host   User   @relation("RoomHost", fields: [hostId], references: [id])

  gameType String // "DRAFT" | "IMPOSTER" | ...
  gameId   String? // tie to Game or Draft (depending on how you want)

  createdAt DateTime @default(now())

  participants RoomParticipant[]

  @@index([hostId])
  @@index([isPublic, status])
}

model RoomParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  isHost    Boolean  @default(false)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
}

model CommunityAd {
  id            String    @id @default(cuid())
  title         String
  body          String?
  imageUrl      String?
  targetUrl     String
  category      String?
  placement     String    @default("rail") // rail | footer
  status        String    @default("pending") // pending | approved | rejected
  submittedById String?
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  submittedBy User? @relation("UserAds", fields: [submittedById], references: [id])

  @@index([status, placement, startsAt, endsAt])
}

model RevenueEvent {
  id          String   @id @default(cuid())
  userId      String?
  source      String // "stripe" | "adsense" | "house"
  type        String // "subscription" | "impression"
  amountCents Int      @default(0)
  currency    String   @default("usd")
  metadata    Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([source, type, createdAt])
}

model NBAPlayer {
  id                String  @id @default(cuid())
  name              String
  firstName         String
  lastName          String
  position          String // Primary position: "PG" | "SG" | "SF" | "PF" | "C" | "UNK"
  eligiblePositions String? // All positions player is eligible for (e.g., "PG,SG")
  imageUrl          String?
  heightInches      Int?
  primaryTeam       String?
  primaryEraFrom    Int?
  primaryEraTo      Int?
  isHallOfFamer     Boolean @default(false)
  totalTeams        Int     @default(1)

  fitTopPicEligible Boolean @default(false)

  seasonStats NBAPlayerSeasonStat[]
  draftPicks  NBADraftPick[]

  @@index([name])
}

model NBAPlayerSeasonStat {
  id       String  @id @default(cuid())
  playerId String
  season   Int // season START year (ex: 2025 = 2025–26)
  team     String
  pos      String?

  games   Int?
  minutes Float?

  ppg Float
  apg Float
  rpg Float
  spg Float?
  bpg Float?

  tsPct     Float?
  threeRate Float?
  usgPct    Float?

  per     Float?
  ws      Float?
  wsPer48 Float?
  bpm     Float?
  obpm    Float?
  dbpm    Float?
  vorp    Float?

  plusMinusPer100    Float?
  netPlusMinusPer100 Float?

  ptsPer36 Float?
  trbPer36 Float?
  astPer36 Float?
  stlPer36 Float?
  blkPer36 Float?

  allStar    Boolean @default(false)
  allNBA     Int? // 1,2,3
  allDefense Int?
  allRookie  Boolean @default(false)
  mvpShare   Float?
  dpoyShare  Float?

  player NBAPlayer @relation(fields: [playerId], references: [id])

  @@unique([playerId, season])
  @@index([season])
}

model NFLPlayer {
  id        String @id @default(cuid())
  name      String
  firstName String
  lastName  String

  rawPosition   String?
  normalizedPos String // QB, RB, WR, TE, OL, DL, LB, DB, K, DEF, HC
  positionTags  String[] // EDGE, FS, SLOT, etc.

  primaryEraFrom Int?
  primaryEraTo   Int?
  teams          String[]

  hallOfFame    Boolean @default(false)
  proBowls      Int     @default(0)
  allPros       Int     @default(0)
  championships Int     @default(0)
  careerAV      Float?

  fitTopPicEligible Boolean @default(false)

  seasons       NFLPlayerSeasonStat[]
  nfldraftPicks NFLDraftPick[]

  @@index([name])
  @@index([normalizedPos])
}

model NFLPlayerSeasonStat {
  id       String @id @default(cuid())
  playerId String
  season   Int
  team     String

  games Int?

  yards            Int?
  touchdowns       Int?
  receptions       Int?
  sacks            Float?
  interceptions    Int?
  fantasyPoints    Float?
  approximateValue Float?

  player NFLPlayer @relation(fields: [playerId], references: [id])

  @@unique([playerId, season])
  @@index([season])
}

model Draft {
  id        String   @id @default(cuid())
  gameId    String
  title     String?
  league    String // "NBA"
  mode      String // "standard" | "free"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  randomEra      Boolean @default(true)
  eraFrom        Int?
  eraTo          Int?
  randomTeam     Boolean @default(true)
  teamConstraint String?

  maxPlayers       Int     @default(5)
  requirePositions Boolean @default(true)

  scoringMethod  String @default("system")
  rules          Json // { maxPpgCap, overallCap, hallRule, multiTeamOnly, playedWithPlayerId, peakMode }
  participants   Int    @default(1)
  playersPerTeam Int    @default(6)

  ownerId String? // nullable for anonymous/offline games
  owner   User?   @relation(fields: [ownerId], references: [id])

  picks        NBADraftPick[]
  nflPicks     NFLDraftPick[]
  cartoonPicks CartoonDraftPick[]
  votes        Vote[]
  styles       DraftStyle[]

  game Game @relation(fields: [gameId], references: [id])

  @@index([ownerId, createdAt])
  @@index([gameId])
}

model DraftStyle {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  visibility  String   @default("private") // "private" | "public"
  settings    Json
  plays       Int      @default(0)
  thumbsUp    Int      @default(0)
  thumbsDown  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User    @relation(fields: [ownerId], references: [id])
  draft   Draft?  @relation(fields: [draftId], references: [id])
  draftId String?

  @@index([ownerId])
  @@index([visibility, plays])
}

model NBADraftPick {
  id       String @id @default(cuid())
  draftId  String
  playerId String
  slot     Int
  position String

  draft      Draft     @relation(fields: [draftId], references: [id])
  player     NBAPlayer @relation(fields: [playerId], references: [id])
  ownerIndex Int       @default(1)
  seasonUsed Int?
  teamUsed   String?

  @@unique([draftId, slot])
  @@index([draftId, ownerIndex])
  @@index([draftId, slot])
}

model NFLDraftPick {
  id       String @id @default(cuid())
  draftId  String
  playerId String
  slot     Int
  position String

  draft      Draft     @relation(fields: [draftId], references: [id])
  player     NFLPlayer @relation(fields: [playerId], references: [id])
  ownerIndex Int       @default(1)
  seasonUsed Int?
  teamUsed   String?

  @@unique([draftId, slot])
  @@index([draftId, ownerIndex])
  @@index([draftId, slot])
}

model Vote {
  id        String   @id @default(cuid())
  draftId   String
  createdAt DateTime @default(now())
  value     Int // +1, -1 (or 1 only)
  draft     Draft    @relation(fields: [draftId], references: [id])

  @@index([draftId])
}

model CartoonShow {
  id           String           @id @default(cuid())
  name         String           @unique
  channel      CartoonChannel?
  category     CartoonCategory
  ageRating    CartoonAgeRating
  yearFrom     Int
  yearTo       Int?
  imdbRating   Float?
  googleRating Float?
  createdAt    DateTime         @default(now())

  characters CartoonCharacter[]
  draftPicks CartoonDraftPick[]
}

model CartoonCharacter {
  id                String        @id @default(cuid())
  name              String
  showId            String
  gender            CartoonGender
  isMainCharacter   Boolean
  isSuperhero       Boolean
  fitTopPicEligible Boolean       @default(true)
  createdAt         DateTime      @default(now())

  show       CartoonShow        @relation(fields: [showId], references: [id])
  draftPicks CartoonDraftPick[]

  @@unique([name, showId])
  @@index([showId])
}

model CartoonDraftPick {
  id          String             @id @default(cuid())
  draftId     String
  showId      String?
  characterId String?
  slot        Int
  ownerIndex  Int                @default(1)
  entityType  CartoonDraftEntity
  createdAt   DateTime           @default(now())

  draft     Draft             @relation(fields: [draftId], references: [id])
  show      CartoonShow?      @relation(fields: [showId], references: [id])
  character CartoonCharacter? @relation(fields: [characterId], references: [id])

  @@unique([draftId, slot])
  @@index([draftId])
  @@index([showId])
  @@index([characterId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  type      String // "feedback" | "bug"
  category  String?
  message   String
  url       String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model TopPicCardReport {
  id         String   @id @default(cuid())
  promptId   String
  promptText String
  pool       String
  rating     String?
  roomCode   String?
  reason     String?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([promptId, createdAt])
}

/// A Jeopardy category with four clues (rows 100-400), written by hand or generated and verified by the AI.
model TriviaCategory {
  id         String    @id @default(cuid())
  pool       String
  name       String
  clues      Json
  source     String // "seed" | "ai"
  uses       Int       @default(0)
  lastUsedAt DateTime?
  retired    Boolean   @default(false)
  flagged    Boolean   @default(false) // an admin marked it for review
  createdAt  DateTime  @default(now())

  @@unique([pool, name])
  @@index([pool, uses])
}

/// A Family Feud survey: a question with its ranked answers and some plausible wrong ones.
model TriviaSurvey {
  id         String    @id @default(cuid())
  pool       String
  q          String
  answers    String[]
  decoys     String[]
  source     String // "seed" | "ai"
  uses       Int       @default(0)
  lastUsedAt DateTime?
  retired    Boolean   @default(false)
  flagged    Boolean   @default(false) // an admin marked it for review
  createdAt  DateTime  @default(now())

  @@unique([pool, q])
  @@index([pool, uses])
}

/// A shelf product with a typical price at one store, from Open Prices. Costimation reads these; games never call Open Prices.
model CostProduct {
  id          String    @id @default(cuid())
  code        String
  name        String
  brand       String?
  quantity    String?
  category    String?
  imageUrl    String?
  kind        String
  country     String
  countryName String
  store       String
  currency    String
  price       Float
  samples     Int       @default(1)
  priceDate   DateTime?
  uses        Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([code, store, currency])
  @@index([country, store])
  @@index([uses])
}

/// A player's rating of a category, a clue inside one, or a survey. One row per voter and target; voting again replaces it.
model TriviaRating {
  id         String   @id @default(cuid())
  kind       String // "category" | "clue" | "survey"
  targetId   String // TriviaCategory.id or TriviaSurvey.id
  clue       Int      @default(-1) // clue index for kind "clue", otherwise -1
  voter      String // anonymous id kept in the player's browser, or a user id
  quality    Int? // 1 to 5 stars
  difficulty Int? // 1 too easy ... 3 just right ... 5 too hard
  wrong      Boolean  @default(false) // "the answer is wrong"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, targetId, clue, voter])
  @@index([kind, targetId])
}

/// The puzzle everyone plays on a given day, saved the first time it is asked for so it never changes that day.
model DailyPuzzle {
  id        String   @id @default(cuid())
  game      String // "summit" | "hotair" | "costimation"
  day       String // UTC date, YYYY-MM-DD
  content   Json
  createdAt DateTime @default(now())

  @@unique([game, day])
}

/// One player's result for a daily puzzle. The first result counts; replays do not change it.
model DailyResult {
  id        String   @id @default(cuid())
  game      String
  day       String
  player    String // anonymous id kept in the player's browser
  score     Float // 0 to 1: how far along the journey they got
  detail    Json?
  createdAt DateTime @default(now())

  @@unique([game, day, player])
  @@index([game, day])
}

// ───────────────────────────── Content ─────────────────────────────
// What the games are played with. These tables are the source of truth for topics, the things in them and their
// stats; `npm run content:export` writes them back out as the JSON catalogs the game engines bundle, so a game
// never waits on the database. Every stat number says where it came from.

/// Where a number comes from: a public dataset, an API, or our own rubric.
model Source {
  id      String @id // "worldbank"
  name    String
  url     String @default("")
  licence String @default("")

  statDefs StatDef[]
  stats    EntityStat[]
}

/// A stat a family of topics is rated on. `method` says whether its numbers are computed from the source or estimated.
model StatDef {
  id        String @id @default(cuid())
  family    String // "basketball", "characters", "countries" ...
  key       String // "defense"
  label     String // noun: "defense"
  best      String // superlative: "Best defender"
  code      String // three letters for tight cards: "DEF"
  method    String // "measured" | "editorial"
  basis     String // one line a player can read
  sortOrder Int    @default(0)
  sourceId  String

  source Source @relation(fields: [sourceId], references: [id])

  @@unique([family, key])
}

/// A topic players can draft from or be quizzed on.
model Topic {
  id         String   @id // "films"
  title      String
  blurb      String
  section    String // "characters" | "sports" | "screen" | "world" | "gear"
  kind       String // "character" (draftable) | "item" (Loadout slots only)
  statFamily String
  /// A mixed pool lists the topics it is made of ("fictional" holds heroes, villains, anime ...) and has no entities of its own.
  includes   String[] @default([])
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)

  entities Entity[]
}

/// One thing in a topic: a character, a film, a country, a player.
model Entity {
  id         String   @id @default(cuid())
  topicId    String
  slug       String
  name       String
  /// The group it belongs to inside the topic: a franchise, a genre, a continent, a team.
  universe   String   @default("")
  archetype  String   @default("")
  tags       String[] @default([])
  /// Real-world details used for clues (a player's height, teams, best season).
  facts      Json?
  /// Exact lookup for its picture when the name alone finds the wrong one.
  imageQuery String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic Topic            @relation(fields: [topicId], references: [id])
  stats EntityStat[]
  votes EntityStatVote[]

  @@unique([topicId, slug])
  @@index([topicId, active])
}

/// One rating, 0 to 100. `measured` is true when it was computed from `source`, false when it is an estimate.
model EntityStat {
  entityId  String
  key       String
  value     Int
  measured  Boolean  @default(false)
  sourceId  String?
  updatedAt DateTime @updatedAt

  entity Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id])

  @@id([entityId, key])
}

/// A player saying an estimated rating is too low (+1) or too high (-1). One vote per voter per rating; voting again replaces it.
/// Editors use the totals to correct editorial stats; measured stats are not open to votes.
model EntityStatVote {
  id        String   @id @default(cuid())
  entityId  String
  key       String
  voter     String // anonymous id kept in the player's browser, or a user id
  direction Int // +1 should be higher, -1 should be lower
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, key, voter])
  @@index([entityId, key])
}

/// A way to judge a draft: a title and how much each stat counts.
model Mission {
  id        String   @id @default(cuid())
  family    String
  slug      String
  title     String
  blurb     String   @default("")
  weights   Json // { stat key: weight }
  wantTags  String[] @default([])
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  @@unique([family, slug])
}

// ───────────────────────────── Custom mode ─────────────────────────────

/// A player's own version of a game. `content` is checked by the shared rules in app/topicDraft/custom.ts
/// before it is saved and again before it is published.
model CustomGame {
  id          String    @id @default(cuid())
  /// Short share code in the link: toppicgames.com/community/k3f9x2ab
  slug        String    @unique
  authorId    String
  kind        String // "draft" | "summit" | "hotair"
  title       String
  description String    @default("")
  content     Json
  status      String    @default("draft") // "draft" | "published" | "removed"
  /// "public" games are listed; "unlisted" ones open only from their link.
  visibility  String    @default("public")
  plays       Int       @default(0)
  likes       Int       @default(0)
  dislikes    Int       @default(0)
  reports     Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  author      User               @relation(fields: [authorId], references: [id])
  ratings     CustomGameRating[]
  reportItems CustomGameReport[]

  @@index([status, visibility, plays])
  @@index([status, visibility, publishedAt])
  @@index([authorId, updatedAt])
}

/// One player's thumbs up (+1) or down (-1) on a custom game. Voting again replaces it.
model CustomGameRating {
  gameId    String
  voter     String // anonymous id kept in the player's browser, or a user id
  value     Int
  updatedAt DateTime @updatedAt

  game CustomGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, voter])
}

model CustomGameReport {
  id        String   @id @default(cuid())
  gameId    String
  reporter  String // anonymous id or user id, so one person cannot report a game twice
  reason    String
  createdAt DateTime @default(now())

  game CustomGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, reporter])
}
